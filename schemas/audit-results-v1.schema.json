{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Animus-OSC/argus-open/schemas/audit-results-v1.schema.json",
  "description": "Structural schema only. The Argus finalizer additionally enforces byte/depth limits, duplicate keys/IDs, text/path restrictions, scope, completeness and local artifact hashes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "plan_sha256",
    "run_id",
    "project_id",
    "source_sha",
    "stages"
  ],
  "properties": {
    "version": {
      "const": "argus.audit-results/v1"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "stages": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage_id",
          "state",
          "exit_code",
          "checks_run",
          "summary",
          "evidence"
        ],
        "properties": {
          "stage_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "state": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN",
              "UNCERTAIN"
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 255
          },
          "checks_run": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "evidence": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "state": {
                  "enum": [
                    "PASS",
                    "FAIL"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "exit_code": {
                  "type": "integer"
                },
                "checks_run": {
                  "minimum": 1
                },
                "evidence": {
                  "minItems": 1
                }
              }
            },
            "else": {
              "properties": {
                "exit_code": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "PASS"
                }
              }
            },
            "then": {
              "properties": {
                "exit_code": {
                  "const": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "FAIL"
                }
              }
            },
            "then": {
              "properties": {
                "exit_code": {
                  "minimum": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "state": {
                  "const": "NOT_RUN"
                }
              }
            },
            "then": {
              "properties": {
                "checks_run": {
                  "const": 0
                }
              }
            }
          }
        ]
      }
    }
  }
}
