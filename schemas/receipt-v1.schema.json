{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.invalid/schemas/receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt", "sha256"],
  "properties": {
    "sha256": {"$ref": "#/$defs/digest"},
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "task_id", "tenant_id", "project_id", "source_sha", "idempotency_key", "event_sha256", "policy_version", "model", "observation", "state"],
      "properties": {
        "version": {"const": "argus.receipt/v1"},
        "task_id": {"type": "string", "minLength": 1},
        "tenant_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "source_sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "idempotency_key": {"type": "string", "minLength": 1},
        "event_sha256": {"$ref": "#/$defs/digest"},
        "policy_version": {"type": "string", "minLength": 1},
        "model": {
          "type": "object", "additionalProperties": false, "required": ["provider", "digest"],
          "properties": {"provider": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}
        },
        "observation": {
          "type": "object", "additionalProperties": false,
          "required": ["operation", "worker", "exit_code", "tests_run", "started_at", "finished_at", "output_sha256"],
          "properties": {
            "operation": {"const": "synthetic-python-unit/v1"},
            "worker": {"type": "string", "minLength": 1},
            "exit_code": {"type": "integer", "minimum": 0, "maximum": 255},
            "tests_run": {"type": "integer", "minimum": 1, "maximum": 99999},
            "started_at": {"type": "string", "format": "date-time"},
            "finished_at": {"type": "string", "format": "date-time"},
            "output_sha256": {"$ref": "#/$defs/digest"}
          }
        },
        "state": {"enum": ["PASS", "FAIL"]}
      }
    }
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}
}
